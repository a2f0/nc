{
  "name": "nc",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "agent-tool": "agent-tool",
    "agents:check": "agent-tool skills check",
    "agents:sync": "agent-tool skills install --apply",
    "l10n": "bun l10n/build.ts",
    "l10n:check": "tsc -p l10n && bun l10n/build.ts --check",
    "test": "bun test fastlane web l10n",
    "web:build": "bun web/build.ts",
    "web:check": "tsc -p web",
    "web:dev": "bun web/serve.ts",
    "web:deploy": "bun run web:build && wrangler deploy --config web/wrangler.jsonc",
    "web:preview": "bun run web:build && wrangler dev --config web/wrangler.jsonc --local"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.10",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
