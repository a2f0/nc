# SwiftFormat (pinned in .mise.toml). Checked by `bun run lint:swift`; apply with
# `bun run format:swift`. SwiftLint (.swiftlint.yml) leaves layout to this file.
# Generated by `bun run l10n`.
--exclude ios/Shared/AppLanguage.swift

--swift-version 6.2
--language-mode 6
--max-width 120
--indent 4
--ranges no-space
--decimal-grouping 3,5
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--import-grouping testable-last

# Keep short single-expression bodies on one line, as the Kotlin sources do, and keep
# explicit Sendable conformances, which document intent and fail at the declaration.
--disable wrapFunctionBodies,wrapPropertyBodies,wrapIfStatementBodies,wrapLoopBodies,redundantSendable
# Whether a comment documents the declaration after it is left to its author.
--disable docComments

--enable isEmpty,preferContains,preferCountWhere,preferFirstWhere,preferMinOverSorted
--enable blockComments
