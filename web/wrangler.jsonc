{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nc",
  "main": "worker.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  // Preserve the upload policy across Wrangler's default change.
  "upload_source_maps": false,
  // Terraform in a2f0/a2f0.net owns the custom domain (nc.a2f0.net).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get dist/404.html with status 404.
    "not_found_handling": "404-page",
    "run_worker_first": ["/review/*"]
  },
  "r2_buckets": [
    { "binding": "PLAY_EVIDENCE", "bucket_name": "nc-store-evidence" }
  ]
}
