root = true

# ktlint (pinned in .mise.toml), checked by `bun run lint:kotlin`; apply with
# `bun run format:kotlin`. Android Studio reads these settings too.
[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable

# Generated by `bun run l10n`.
[android/app/src/main/java/net/a2f0/nc/Language.kt]
ktlint_standard = disabled
