                            </imageView>
                        </subviews>
                        <constraints>
                            <constraint firstItem="Lnc-Bg-001" firstAttribute="top" secondItem="Lnc-Vw-001" secondAttribute="top" id="Lnc-Cn-001"/>
                            <constraint firstItem="Lnc-Bg-001" firstAttribute="bottom" secondItem="Lnc-Vw-001" secondAttribute="bottom" id="Lnc-Cn-002"/>
                            <constraint firstItem="Lnc-Bg-001" firstAttribute="leading" secondItem="Lnc-Vw-001" secondAttribute="leading" id="Lnc-Cn-003"/>
