                            <constraint firstItem="Lnc-Lg-001" firstAttribute="centerX" secondItem="Lnc-Vw-001" secondAttribute="centerX" id="Lnc-Cn-005"/>
                            <constraint firstItem="Lnc-Lg-001" firstAttribute="centerY" secondItem="Lnc-Vw-001" secondAttribute="centerY" id="Lnc-Cn-006"/>
