    "noise_fan_blurb" : {
      "comment" : "Describes the fan sound, under its name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gleichmäßiger Luftstrom über einem tiefen Brummen."
