    "noise_brown_blurb" : {
      "comment" : "Describes brown noise, under its name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor allem Bässe, gedämpfte Höhen. Ein tiefes, weiches Grollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostly lows, muffled highs. A deep, soft rumble."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre todo graves, agudos apagados. Un rumor profundo y suave."
          }
        }
      }
    },
