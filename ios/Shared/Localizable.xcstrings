    "noise_pink_blurb" : {
      "comment" : "Describes pink noise, under its name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanftere Höhen, tiefere Bässe. Wie gleichmäßiger Regen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softer highs, deeper lows. Like steady rain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agudos más suaves, graves más profundos. Como una lluvia constante."
          }
        }
      }
    },
