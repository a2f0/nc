// Settings shared by the app and the widget extension.
// The bundle ID is permanent once the app is created in App Store Connect.
BASE_BUNDLE_ID = net.a2f0.nc
APP_GROUP_ID = group.$(BASE_BUNDLE_ID)

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// The String Catalog (Shared/Localizable.xcstrings) is generated from l10n/ by `bun run
// l10n`, so Xcode shouldn't add the strings it finds in the code to it.
SWIFT_EMIT_LOC_STRINGS = NO

// Strict compilation, matched by scripts/testing/testIosAudio.sh: warnings are errors, two
// Swift 7 checks are on early (explicit `any`, and only using members of imported modules),
// and unsafe code, such as the render callback's audio buffers, must be marked `unsafe`.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_STRICT_MEMORY_SAFETY = YES
