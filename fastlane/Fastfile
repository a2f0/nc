# frozen_string_literal: true

require 'shellwords'
require 'tmpdir'
require_relative 'lib/ios_signing_keychain'
require_relative 'lib/play_version_code'
require_relative 'lib/secrets'
require_relative 'lib/store_listing'
require_relative 'lib/readiness_artifacts'
require_relative 'lib/readiness_stores'
require_relative 'lib/play_evidence'

REPO_ROOT = File.expand_path('..', __dir__)
APP_NAME = 'Noise Connoisseur'
APP_IDENTIFIER = 'net.a2f0.nc'
WIDGET_IDENTIFIER = "#{APP_IDENTIFIER}.widget".freeze
APP_GROUP_IDENTIFIER = "group.#{APP_IDENTIFIER}".freeze
APP_SKU = 'noise-connoisseur'

IOS_PROJECT = File.join(REPO_ROOT, 'ios/NoiseConnoisseur.xcodeproj')
IOS_SCHEME = 'NoiseConnoisseur'
IOS_TARGET_IDENTIFIERS = {
  'NoiseConnoisseur' => APP_IDENTIFIER,
  'NoiseWidgetExtension' => WIDGET_IDENTIFIER
}.freeze
IOS_OUTPUT_DIR = File.join(REPO_ROOT, 'ios/build/release')

ANDROID_DIR = File.join(REPO_ROOT, 'android')
ANDROID_KEYSTORE_PATH = File.join(SECRETS_DIR, 'nc-upload.keystore')
ANDROID_OUTPUTS_DIR = File.join(ANDROID_DIR, 'app/build/outputs')
ANDROID_RELEASE_AAB = File.join(ANDROID_OUTPUTS_DIR, 'bundle/release/app-release.aab')
ANDROID_RELEASE_MAPPING = File.join(ANDROID_OUTPUTS_DIR, 'mapping/release/mapping.txt')
GOOGLE_PLAY_TRACKS = %w[production beta alpha internal].freeze

# Listing text is committed; screenshots are generated (see StoreListing).
IOS_METADATA_DIR = File.join(REPO_ROOT, 'fastlane/metadata/ios')
ANDROID_METADATA_DIR = File.join(REPO_ROOT, 'fastlane/metadata/android')
SCREENSHOTS_DIR = File.join(REPO_ROOT, '.screenshots')

default_platform(:ios)
skip_docs

# MARK: - iOS

def ios_signing_keychain(&)
  setup = lambda do |name, password|
    # Xcode resolves nested (widget) signing through the default keychain.
    # IosSigningKeychain puts it first in the search list.
    create_keychain(
      name: name, password: password, default_keychain: true, unlock: true,
      timeout: 0, lock_when_sleeps: true, add_to_search_list: false, require_create: true
    )
  end
  # delete_keychain also restores the default keychain create_keychain replaced.
  cleanup = proc { |name| delete_keychain(name: name) if ios_signing_keychain_exists?(name) }
  IosSigningKeychain.with_temporary(
    environment: ENV, setup: setup, cleanup: cleanup,
    security: ->(*args) { sh('security', *args, log: false) },
    path: ->(name) { FastlaneCore::Helper.keychain_path(name) }, &
  )
end

# Setup can fail before the keychain exists; deleting it then would mask that error.
def ios_signing_keychain_exists?(name)
  base = File.join(Dir.home, 'Library', 'Keychains', name)
  ["#{base}-db", "#{base}.keychain-db", base, "#{base}.keychain"].any? { |path| File.file?(path) }
end

def appstore_profile_names
  IOS_TARGET_IDENTIFIERS.values.to_h do |identifier|
    [identifier, ENV.fetch("sigh_#{identifier}_appstore_profile-name", "match AppStore #{identifier}")]
  end
end

# Pins manual App Store signing on each target's Release configuration for the
# duration of the block, then restores the project file.
def with_manual_ios_signing(team_id, profiles)
  pbxproj = File.join(IOS_PROJECT, 'project.pbxproj')
  original = File.read(pbxproj)
  IOS_TARGET_IDENTIFIERS.each do |target, identifier|
    update_code_signing_settings(
      path: IOS_PROJECT, use_automatic_signing: false, team_id: team_id,
      code_sign_identity: 'Apple Distribution', profile_name: profiles.fetch(identifier),
      targets: [target], build_configurations: ['Release']
    )
  end
  yield
ensure
  File.write(pbxproj, original) unless original.nil?
end

def ios_build_xcargs(build_number, team_id)
  settings = ["CURRENT_PROJECT_VERSION=#{build_number}", "DEVELOPMENT_TEAM=#{team_id}"]
  keychain = ENV.fetch('MATCH_KEYCHAIN_NAME', '')
  unless keychain.empty?
    settings << "OTHER_CODE_SIGN_FLAGS=#{Shellwords.escape("--keychain #{FastlaneCore::Helper.keychain_path(keychain)}")}"
  end
  settings.join(' ')
end

# Whether the App Store version being prepared has App Review details yet.
def ios_review_details?
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  version = app&.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  UI.user_error!("No App Store version of #{APP_IDENTIFIER} to edit") unless version
  version.fetch_app_store_review_detail
  true
rescue RuntimeError => e
  # Spaceship raises this for an empty relationship.
  raise unless e.message == 'No data'

  false
end

def readiness_options(options, platform, default_artifact)
  artifact = File.expand_path(options.fetch(:artifact, default_artifact), REPO_ROOT)
  output = File.expand_path(options.fetch(:output, ".readiness/#{platform}.json"), REPO_ROOT)
  UI.user_error!('Report output must not overwrite its artifact or build receipt') if [artifact, "#{artifact}.build.json"].include?(output)
  [artifact, output]
end

def release_source
  Readiness.source(REPO_ROOT)
rescue Readiness::CommandError, Errno::ENOENT
  UI.user_error!('Could not read build source with git; install git and run from the repository checkout.')
end

def finish_readiness(report, output, options)
  Readiness.manual_checks(report)
  report.write(output)
  UI.message("Readiness: #{report.result}; report: #{output}")
  report.data[:checks].each { |check| UI.message("#{check[:status]} #{check[:id]}: #{check[:detail]}") }
  UI.user_error!("Readiness is #{report.result}; see #{output}") if options[:strict].to_s == 'true' && report.result != 'ready_within_tested_scope'
  report.data
end

platform :ios do
  desc 'Register the app and widget bundle IDs with App Groups enabled (App Store Connect API key)'
  lane :register_identifiers do
    load_store_secrets(IOS_SECRETS)
    app_store_connect_api_key(**app_store_connect_api_key_options)
    { APP_IDENTIFIER => APP_NAME, WIDGET_IDENTIFIER => "#{APP_NAME} Widget" }.each do |identifier, name|
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier) ||
                  Spaceship::ConnectAPI::BundleId.create(
                    name: name, platform: Spaceship::ConnectAPI::Platform::IOS, identifier: identifier
                  )
      app_groups = Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS
      unless bundle_id.get_capabilities.any? { |capability| capability.capability_type == app_groups }
        bundle_id.create_capability(app_groups)
      end
      UI.success("#{identifier}: registered with App Groups")
    end
  end

  # match keeps the App Store profiles in the encrypted certificates repo
  # (MATCH_GIT_URL), where beta installs them from. This creates a profile when
  # it's missing or no longer valid; force:true regenerates them, as after the
  # bundle IDs' capabilities or the distribution certificate change.
  desc 'Create or renew the match App Store profiles (App Store Connect API key; force:true regenerates them)'
  lane :profiles do |options|
    load_store_secrets(IOS_SECRETS)
    api_key = app_store_connect_api_key(**app_store_connect_api_key_options)
    ios_signing_keychain do
      # readonly: false overrides the MATCH_READONLY the signing keychain sets.
      match(
        type: 'appstore', app_identifier: IOS_TARGET_IDENTIFIERS.values, api_key: api_key, readonly: false,
        force: options[:force].to_s == 'true'
      )
    end
  end

  # Apple has no API for creating App Store Connect apps or App Groups, so this
  # lane logs in with your Apple ID (APPLE_ID) and needs a 2FA code. Run it once,
  # in a terminal.
  desc 'Create the App Store Connect app, App Group, and App Store profiles (Apple ID login)'
  lane :create_app do
    load_store_secrets(IOS_SECRETS)
    username = required_env('APPLE_ID')
    team_id = required_env('TEAM_ID')

    produce(
      username: username, team_id: team_id, itc_team_id: ENV.fetch('ITC_TEAM_ID', nil),
      app_identifier: APP_IDENTIFIER, app_name: APP_NAME, sku: APP_SKU, language: 'en-US',
      platforms: ['ios'], enable_services: { app_group: 'on' }
    )
    produce(
      username: username, team_id: team_id,
      app_identifier: WIDGET_IDENTIFIER, app_name: "#{APP_NAME} Widget",
      skip_itc: true, enable_services: { app_group: 'on' }
    )

    # Reuses the session produce just opened.
    Spaceship::Portal.login(username)
    Spaceship::Portal.select_team(team_id: team_id)
    group = Spaceship::Portal.app_group.find(APP_GROUP_IDENTIFIER) ||
            Spaceship::Portal.app_group.create!(group_id: APP_GROUP_IDENTIFIER, name: APP_NAME)
    IOS_TARGET_IDENTIFIERS.each_value do |identifier|
      Spaceship::Portal.app.find(identifier).associate_groups([group])
      UI.success("#{identifier}: in #{APP_GROUP_IDENTIFIER}")
    end

    # Profiles embed the App Group, so create them after the association.
    profiles
  end

  desc 'Build and sign an IPA with a source/hash receipt, without uploading'
  lane :build_release do |options|
    source = release_source
    load_store_secrets(IOS_SECRETS)
    team_id = required_env('TEAM_ID')
    api_key = app_store_connect_api_key(**app_store_connect_api_key_options)
    build_number = options[:build_number]&.to_i ||
                   (latest_testflight_build_number(
                     api_key: api_key, app_identifier: APP_IDENTIFIER, initial_build_number: 0
                   ).to_i + 1)
    UI.message("Building #{APP_IDENTIFIER} build #{build_number}")

    ipa = ios_signing_keychain do
      match(type: 'appstore', app_identifier: IOS_TARGET_IDENTIFIERS.values, api_key: api_key, readonly: true)
      profiles = appstore_profile_names
      with_manual_ios_signing(team_id, profiles) do
        build_app(
          project: IOS_PROJECT, scheme: IOS_SCHEME, configuration: 'Release', clean: true,
          export_method: 'app-store',
          export_options: {
            method: 'app-store', signingStyle: 'manual', teamID: team_id,
            provisioningProfiles: profiles, manageAppVersionAndBuildNumber: false, uploadSymbols: true
          },
          output_directory: IOS_OUTPUT_DIR, output_name: 'NoiseConnoisseur.ipa',
          xcargs: ios_build_xcargs(build_number, team_id)
        )
      end
    end

    Readiness.record_build(ipa, source, root: REPO_ROOT)
    ipa
  end

  desc 'Build, sign (match), and upload to TestFlight'
  lane :beta do |options|
    ipa = build_release(options)
    api_key = app_store_connect_api_key(**app_store_connect_api_key_options)
    upload_to_testflight(
      api_key: api_key, app_identifier: APP_IDENTIFIER, ipa: ipa,
      skip_submission: true, skip_waiting_for_build_processing: true, uses_non_exempt_encryption: false
    )
  end

  desc 'Inspect an existing IPA and store state; write a redacted readiness report (no uploads or submission)'
  lane :readiness do |options|
    artifact, output = readiness_options(options, 'ios', File.join(IOS_OUTPUT_DIR, 'NoiseConnoisseur.ipa'))
    timeout = begin
      Integer(options.fetch(:wait_timeout, 0).to_s, 10)
    rescue ArgumentError
      UI.user_error!('wait_timeout must be between 0 and 1800 seconds')
    end
    UI.user_error!('wait_timeout must be between 0 and 1800 seconds') unless (0..1800).cover?(timeout)
    report = Readiness::Report.new('ios', artifact, REPO_ROOT)
    Readiness.ios_artifact(report, artifact)
    if options[:store].to_s == 'false'
      report.add('store.ios', 'unverified', 'Store inspection explicitly skipped.')
    else
      report.attempt('store.authentication') do
        load_store_secrets(IOS_SECRETS)
        api_key = app_store_connect_api_key(**app_store_connect_api_key_options)
        locales = Dir.children(IOS_METADATA_DIR).select { |entry| File.file?(File.join(IOS_METADATA_DIR, entry, 'description.txt')) }.sort
        Readiness.ios_store(report, locales: locales, timeout: timeout)
        if options[:precheck].to_s == 'false'
          report.add('store.precheck', 'unverified', 'Metadata precheck explicitly skipped.')
        else
          report.attempt('store.precheck') do
            begin
              passed = precheck(api_key: api_key, app_identifier: APP_IDENTIFIER, include_in_app_purchases: false)
              report.check('store.precheck', passed == true, 'Fastlane rules for the editable listing; exact candidate fields are checked separately. Not a full policy/accessibility audit.')
            rescue FastlaneCore::Interface::FastlaneError => error
              raise unless error.message.include?('found one or more potential problems that must be addressed')
              report.check('store.precheck', false, 'Precheck rejected listing metadata; see its rule findings above.')
            end
          end
        end
      end
    end
    finish_readiness(report, output, options)
  end

  # Edits the version being prepared for submission; doesn't submit it. deliver
  # can't upload the text until that version's App Review details exist
  # (fastlane/fastlane#20538), and creating them takes a contact name and phone
  # number, which stay out of the repository. Until they're added in App Store
  # Connect, this uploads only the screenshots and then fails.
  desc 'Upload the App Store listing: fastlane/metadata/ios text and .screenshots/ios screenshots'
  lane :listing do
    load_store_secrets(IOS_SECRETS)
    api_key = app_store_connect_api_key(**app_store_connect_api_key_options)
    review_details = ios_review_details?
    Dir.mktmpdir('nc-listing') do |dir|
      deliver(
        api_key: api_key, app_identifier: APP_IDENTIFIER, platform: 'ios',
        metadata_path: IOS_METADATA_DIR, skip_metadata: !review_details,
        screenshots_path: StoreListing.stage_ios_screenshots(SCREENSHOTS_DIR, dir),
        overwrite_screenshots: true, skip_binary_upload: true, skip_app_version_update: true,
        submit_for_review: false, run_precheck_before_submit: false, force: true
      )
    end
    next if review_details

    UI.user_error!(
      'Uploaded the screenshots but not the text: add the App Review contact name and phone number ' \
      '(App Store Connect → the version → App Review Information), then run this again.'
    )
  end
end

# MARK: - Android

def next_google_play_version_code
  missing = lambda do |track, error|
    UI.important("No version codes from the #{track} track (#{error.message.lines.first&.strip})")
  end
  PlayVersionCode.next_code(GOOGLE_PLAY_TRACKS, on_missing: missing) do |track|
    google_play_track_version_codes(package_name: APP_IDENTIFIER, track: track, json_key: GOOGLE_PLAY_JSON_KEY_PATH)
  end
end

# Builds the release App Bundle and uploads it to a Play track, rolled out
# unless options[:release_status] says otherwise. Listing text and images go up
# separately, through the listing lane.
def release_to_play_track(track, options)
  aab = build_release(options)
  upload_to_play_store(
    package_name: APP_IDENTIFIER, json_key: GOOGLE_PLAY_JSON_KEY_PATH,
    aab: aab, mapping: ANDROID_RELEASE_MAPPING,
    track: track, release_status: options.fetch(:release_status, 'completed'),
    skip_upload_apk: true, skip_upload_metadata: true, skip_upload_changelogs: true,
    skip_upload_images: true, skip_upload_screenshots: true
  )
end

platform :android do
  desc 'Record user-started background playback and notification stop from the release AAB'
  lane :foreground_service_video do |options|
    artifact = File.expand_path(options.fetch(:artifact, ANDROID_RELEASE_AAB), REPO_ROOT)
    tool = options[:bundletool] || ENV['BUNDLETOOL_JAR']
    UI.user_error!('Pass bundletool:/absolute/path/bundletool.jar or set BUNDLETOOL_JAR') unless tool
    sh('ruby', File.join(REPO_ROOT, 'scripts/recordAndroidForegroundVideo.rb'), artifact, File.expand_path(tool, REPO_ROOT))
  end

  desc 'Publish a reviewed foreground-service video to R2; update the stable pointer last'
  lane :publish_foreground_service_video do |options|
    UI.user_error!('Watch the recording with sound, then pass reviewed:true to publish it') unless options[:reviewed].to_s == 'true'
    path = File.expand_path(options.fetch(:manifest, '.store-evidence/android-media-playback/manifest.json'), REPO_ROOT)
    data, video = PlayEvidence.inspect_local(path)
    artifact = File.expand_path(options.fetch(:artifact, ANDROID_RELEASE_AAB), REPO_ROOT)
    UI.user_error!('Recording does not match the candidate AAB') unless File.file?(artifact) && Digest::SHA256.file(artifact).hexdigest == data['aab_sha256']
    sh('bunx', '--no-install', 'wrangler', 'r2', 'object', 'put', "#{PlayEvidence::BUCKET}/#{data['video_key']}",
       '--file', video, '--content-type', 'video/mp4', '--remote')
    sh('bunx', '--no-install', 'wrangler', 'r2', 'object', 'put', "#{PlayEvidence::BUCKET}/#{PlayEvidence::POINTER}",
       '--file', path, '--content-type', 'application/json', '--remote')
    UI.success('Published: https://nc.a2f0.net/review/android-media-playback')
  end

  desc 'Build the release App Bundle, signed with the upload key'
  lane :build_release do |options|
    source = release_source
    load_store_secrets(ANDROID_SECRETS)
    required_env('NC_ANDROID_KEYSTORE_PASS')
    UI.user_error!("Missing upload keystore: #{ANDROID_KEYSTORE_PATH}") unless File.file?(ANDROID_KEYSTORE_PATH)

    version_code = options[:version_code]&.to_i || next_google_play_version_code
    UI.message("Building #{APP_IDENTIFIER} version code #{version_code}")
    sh('sh', File.join(REPO_ROOT, 'scripts/ensureGradleWrapper.sh'))
    gradle(
      project_dir: ANDROID_DIR, task: 'bundleRelease',
      properties: { 'ncVersionCode' => version_code }, flags: '--console=plain'
    )
    UI.user_error!("App Bundle was not created: #{ANDROID_RELEASE_AAB}") unless File.file?(ANDROID_RELEASE_AAB)
    Readiness.record_build(ANDROID_RELEASE_AAB, source, root: REPO_ROOT)
    UI.success("App Bundle: #{ANDROID_RELEASE_AAB}")
    ANDROID_RELEASE_AAB
  end

  # Rolls the release out to internal testers, with no Play Console step. A new
  # Play app only accepts draft releases until its first release has been rolled
  # out by hand; pass release_status:draft to upload one without rolling it out.
  desc 'Build, upload, and roll out the release App Bundle to Google Play internal testers'
  lane :internal do |options|
    release_to_play_track('internal', options)
  end

  # Open testing is Play's beta track. Google reviews each release before
  # testers get it, and the track only takes releases once open testing is set
  # up in Play Console: its countries, and for a personal account created since
  # November 2023, production access.
  desc 'Build, upload, and roll out the release App Bundle to Google Play open testing'
  lane :beta do |options|
    release_to_play_track('beta', options)
  end

  # Promotes the open testing release rather than building a new one, so
  # production gets the App Bundle testers had. Google reviews it first, and
  # Play rejects it until production has countries, which only Play Console
  # sets. Pass version_code: when the track has more than one release, and
  # rollout:0.1 to roll an update out to a share of users.
  desc 'Promote the Google Play open testing release to production'
  lane :production do |options|
    upload_to_play_store(
      package_name: APP_IDENTIFIER, json_key: GOOGLE_PLAY_JSON_KEY_PATH,
      track: 'beta', track_promote_to: 'production', track_promote_release_status: 'completed',
      **options.slice(:version_code, :rollout),
      skip_upload_apk: true, skip_upload_aab: true, skip_upload_metadata: true,
      skip_upload_changelogs: true, skip_upload_images: true, skip_upload_screenshots: true
    )
  end

  desc 'Inspect an existing AAB and Play state; write a redacted readiness report (no uploads or committed edits)'
  lane :readiness do |options|
    artifact, output = readiness_options(options, 'android', ANDROID_RELEASE_AAB)
    track = options.fetch(:track, 'internal').to_s
    UI.user_error!('Unsupported Play track') unless GOOGLE_PLAY_TRACKS.include?(track)
    report = Readiness::Report.new('android', artifact, REPO_ROOT)
    bundletool = options[:bundletool] || ENV['BUNDLETOOL_JAR']
    bundletool = File.expand_path(bundletool, REPO_ROOT) if bundletool
    Readiness.android_artifact(report, artifact, bundletool: bundletool)
    if options[:store].to_s == 'false'
      report.add('store.android', 'unverified', 'Store inspection explicitly skipped.')
    else
      locales = Dir.children(ANDROID_METADATA_DIR).select { |entry| File.file?(File.join(ANDROID_METADATA_DIR, entry, 'title.txt')) }.sort
      Readiness.android_store(report, key_path: GOOGLE_PLAY_JSON_KEY_PATH, locales: locales, track: track)
    end
    evidence_path = options[:evidence] && File.expand_path(options[:evidence], REPO_ROOT)
    PlayEvidence.check(report, artifact, manifest_path: evidence_path, online: options[:store].to_s != 'false')
    finish_readiness(report, output, options)
  end

  # supply only uploads a listing along with a release, so this attaches it to
  # the newest internal one. With no binaries, rollout, promotion, or changelogs,
  # supply only reads that release (it never calls update_track or
  # upload_changelogs), so its status and notes stay as they are.
  desc 'Upload the Google Play listing: fastlane/metadata/android text, .screenshots/android screenshots, and graphics'
  lane :listing do
    version_code = google_play_track_version_codes(
      package_name: APP_IDENTIFIER, track: 'internal', json_key: GOOGLE_PLAY_JSON_KEY_PATH
    ).map(&:to_i).max
    UI.user_error!('No internal release to attach the listing to; run `fastlane android internal` first.') unless version_code

    Dir.mktmpdir('nc-listing') do |dir|
      images = StoreListing.stage_play_listing(ANDROID_METADATA_DIR, SCREENSHOTS_DIR, dir)
      sh('sh', File.join(REPO_ROOT, 'scripts/buildImages.sh'), 'store', '--out', images)
      upload_to_play_store(
        package_name: APP_IDENTIFIER, json_key: GOOGLE_PLAY_JSON_KEY_PATH, metadata_path: dir,
        track: 'internal', version_code: version_code,
        skip_upload_apk: true, skip_upload_aab: true, skip_upload_changelogs: true, sync_image_upload: true
      )
    end
  end
end
